{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Roboto, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif" },
      "mono": { "$value": "\"Roboto Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.5rem" },
      "2xl": { "$value": "2rem" },
      "3xl": { "$value": "2.5rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "bold": { "$value": "700" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": "1.2" },
      "normal": { "$value": "1.5" }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": { "$value": "0" },
      "wide": { "$value": "0.06em" },
      "digital": { "$value": "0.12em" }
    }
  }
}
